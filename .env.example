# FinSec ZeroTrust - Global Environment Variables

# Backend Port & Runtime Environment
PORT=5000
NODE_ENV=production

# Database (PostgreSQL for Docker production or SQLite for local dev)
# Docker PostgreSQL:
DATABASE_URL="postgresql://finsec_user:finsec_secure_password_2026@localhost:5432/finsec_db?schema=public"
# Local SQLite development fallback:
# DATABASE_URL="file:./dev.db"

# Cryptographic Secrets
JWT_SECRET="finsec_super_secret_jwt_access_token_key_2026_xyz_secure"
JWT_REFRESH_SECRET="finsec_super_secret_jwt_refresh_token_key_2026_abc_secure"
HMAC_SECRET="finsec_hmac_request_signing_secret_key_2026_default"

# WebAuthn / Passkeys Configuration
RP_ID="localhost"
RP_NAME="FinSec ZeroTrust"
ORIGIN="http://localhost:5173"

# Google Gemini Vision & AI Assistant Key (Optional - users can also supply in Profile settings)
GEMINI_API_KEY=""
